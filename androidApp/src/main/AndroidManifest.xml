<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        networkSecurityConfig is stated here rather than left to the merger, which would inject it
        from netfreetools.certificates: the same value merges cleanly, and a reader of this file
        should be able to see that the app trusts the NetFree roots without going through the
        dependency graph to find out. android:usesCleartextTraffic used to sit alongside it and is
        gone, not moved - the platform ignores that flag from API 24 once a network security config
        exists, and minSdk here is 26, so it had no effect at all. The one cleartext host the
        catalog still needs is named in the config instead.
    -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".AppActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleInstance"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
